FROM node:22-alpine AS webdist

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@12.5.1 --activate
COPY ant-iam-frontend/package.json ant-iam-frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY ant-iam-frontend/ ./
RUN pnpm build

FROM nginx:alpine

COPY --from=webdist /app/dist/ /usr/share/nginx/html/
COPY deploy/rancher/nginx.conf /etc/nginx/conf.d/default.conf
